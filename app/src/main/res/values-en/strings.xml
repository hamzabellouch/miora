    <!-- Transfer Protocol Dialog -->
    <string name="protocol_dialog_title">Transfer Protocol</string>
    <string name="protocol_dialog_desc">Select the transfer protocol that fits your files:</string>
    <string name="protocol_current_active">Current Protocol: %1$s</string>
    <string name="protocol_wifi_details">Ultra-fast transfers up to 250 Mbps via direct peer-to-peer connection. Best for large 4K videos, full albums, and heavy files without internet.</string>
    <string name="protocol_bluetooth_details">Low-power connection saving battery. Ideal for documents, single photos, and lightweight files without requiring local Wi-Fi.</string>
    <string name="local_wifi">Local Wi-Fi (LAN)</string>
    <string name="protocol_local_wifi">Local Wi-Fi (LAN)</string>
    <string name="protocol_local_wifi_details">Fast, direct transfer over your shared local Wi-Fi router. Requires both devices to be connected to the same Wi-Fi network. Automatically falls back to Wi-Fi Direct if unreachable.</string>
    <string name="enable_lan_transfer">Local Wi-Fi (LAN) Transfer</string>
    <string name="enable_lan_transfer_desc">Allow file transfer through your shared local Wi-Fi router when both devices are on the same network</string>
    <string name="protocol_active_badge">Active</string>
