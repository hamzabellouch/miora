    <!-- Essential App Requirements Dialog -->
    <string name="requirements_dialog_title">App Requirements</string>
    <string name="requirements_dialog_desc">Miora needs the following essential features and permissions to transfer and share files seamlessly:</string>
    <string name="requirements_wifi_title">Wi-Fi</string>
    <string name="requirements_wifi_desc">Required to create high-speed Wi-Fi Direct connections for fast transfers.</string>
    <string name="requirements_bluetooth_title">Bluetooth</string>
    <string name="requirements_bluetooth_desc">Required to discover nearby devices, quick pairing, and offline sharing.</string>
    <string name="requirements_nearby_perm_title">Nearby Devices Permission</string>
    <string name="requirements_nearby_perm_desc">Allows scanning and connecting with nearby Miora devices.</string>
    <string name="requirements_storage_perm_title">Files &amp; Media Permission</string>
    <string name="requirements_storage_perm_desc">Required to select photos, videos, and files for sending and to save received items.</string>
    <string name="requirements_location_title">Location Services (GPS)</string>
    <string name="requirements_location_desc">Required by Android to scan for nearby Wi-Fi networks.</string>
    <string name="requirements_turn_on">Turn on</string>
    <string name="requirements_grant_permission">Grant</string>
    <string name="requirements_granted">Enabled</string>
    <string name="requirements_grant_all">Enable &amp; Grant All</string>
